{
  "name": "oh-my-antigravity",
  "version": "1.0.0",
  "description": "CLI project",
  "main": "dist/src/index.js",
  "type": "module",
  "bin": {
    "oma": "./dist/bin/oma.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin/oma.js",
    "test": "bun test --timeout=120000 --parallel=1 --isolate",
    "test:all": "bun test --timeout=120000 --parallel=1 --isolate",
    "test:runtime": "npm run build && node --test dist/src/runtime/__tests__/secret-scrubber.test.js dist/src/runtime/__tests__/process-runner.test.js dist/src/runtime/__tests__/driver.test.js dist/src/runtime/__tests__/mock-driver.test.js",
    "test:graph": "npm run build && node --test dist/src/graph/__tests__/graph.test.js dist/src/graph/__tests__/proposal.test.js dist/src/graph/__tests__/broker.test.js",
    "test:strict": "npm run build && node --test dist/src/strict/__tests__/policy.test.js",
    "test:broker:cas": "npm run build && node --test dist/src/broker/__tests__/cas.test.js",
    "test:broker:staging": "npm run build && node --test dist/src/broker/__tests__/staging.test.js",
    "test:oracle": "npm run build && node --test dist/src/oracle/__tests__/oracle.test.js",
    "test:broker:promotion": "npm run build && node --test dist/src/broker/__tests__/promotion.test.js",
    "test:ledger": "npm run build && node --test dist/src/ledger/__tests__/journal-store.test.js",
    "test:plugin": "npm run build && node --test dist/src/mcp/__tests__/broker-server.test.js",
    "test:staged-review": "npm run build && node --test --test-concurrency=1 dist/src/orchestration/__tests__/staged-review.test.js",
    "test:live": "npm run build && node --test dist/src/live/__tests__/live-audit.test.js",
    "probe:install": "npm run build && node dist/bin/oma.js probe install",
    "probe:status": "node dist/bin/oma.js probe status",
    "probe:reset": "node dist/bin/oma.js probe reset",
    "probe:report": "node dist/bin/oma.js probe report",
    "probe:uninstall": "node dist/bin/oma.js probe uninstall"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
